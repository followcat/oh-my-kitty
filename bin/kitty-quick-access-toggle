#!/bin/sh
set -eu

KITTY="$HOME/.local/bin/kitty"
CONFIG="$HOME/.config/kitty/dropdown.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kitty-quick-access"
SOCKET_FILE="$STATE_DIR/socket"
HEIGHT_FILE="$STATE_DIR/height"
APP_CLASS="kitty-quick-access-dropdown"
DEFAULT_HEIGHT="${KITTY_QUICK_ACCESS_DEFAULT_HEIGHT:-820}"
MAX_HEIGHT_PERCENT="${KITTY_QUICK_ACCESS_MAX_HEIGHT_PERCENT:-100}"
TOP="${KITTY_DROPDOWN_TOP:-53}"

mkdir -p "$STATE_DIR"

# Verify config file exists before proceeding
if [ ! -f "$CONFIG" ]; then
  printf "ERROR: Config file not found: %s\n" "$CONFIG" >&2
  exit 1
fi

# Make IME work reliably for kitty/fcitx5 on X11.
: "${GTK_IM_MODULE:=fcitx}"
: "${QT_IM_MODULE:=fcitx}"
: "${XMODIFIERS:=@im=fcitx}"
: "${GLFW_IM_MODULE:=ibus}"
export GTK_IM_MODULE QT_IM_MODULE XMODIFIERS GLFW_IM_MODULE

dropdown_height() {
  height="$(cat "$HEIGHT_FILE" 2>/dev/null || true)"
  case "$height" in
    ''|*[!0-9]*) printf '%s\n' "$DEFAULT_HEIGHT" ;;
    *) printf '%s\n' "$height" ;;
  esac
}

max_dropdown_height() {
  set -- $(xdotool getdisplaygeometry)
  screen_height="$2"
  percent_height=$((screen_height * MAX_HEIGHT_PERCENT / 100))
  absolute_max=$((screen_height - TOP))
  [ "$percent_height" -gt "$absolute_max" ] && percent_height="$absolute_max"
  printf '%s\n' "$percent_height"
}

first_window() {
  xdotool search --class "$APP_CLASS" 2>/dev/null | head -n 1
}

is_visible() {
  xwininfo -id "$1" 2>/dev/null | grep -q 'Map State: IsViewable'
}

is_minimized() {
  xprop -id "$1" _NET_WM_STATE 2>/dev/null | grep -q '_NET_WM_STATE_HIDDEN'
}

is_config_applied() {
  wid="$1"
  # Check if opacity is set correctly (0.88) - quick indicator of config application
  opacity=$(xprop -id "$wid" _NET_WM_WINDOW_OPACITY 2>/dev/null | grep -oP 'cardinal \K.*' || echo "0")
  [ "$opacity" != "0" ]
}

layout_window() {
  wid="$1"
  height="$(dropdown_height)"
  set -- $(xdotool getdisplaygeometry)
  width=$(($1 - 14))
  max_height="$(max_dropdown_height)"
  [ "$height" -gt "$max_height" ] && height="$max_height"

  # Force geometry first
  xdotool windowsize "$wid" "$width" "$height" 2>/dev/null || true
  xdotool windowmove "$wid" 0 "$TOP" 2>/dev/null || true
  
  # Remove decorations using MOTIF hints
  xprop -id "$wid" -f _MOTIF_WM_HINTS 32c -set _MOTIF_WM_HINTS "2, 0, 0, 0, 0" 2>/dev/null || true
  
  # Set window properties to prevent centering/repositioning
  xdotool windowactivate "$wid" 2>/dev/null || true
  xprop -id "$wid" -f _NET_WM_STATE 32a -set _NET_WM_STATE \
    "_NET_WM_STATE_ABOVE,_NET_WM_STATE_SKIP_TASKBAR,_NET_WM_STATE_SKIP_PAGER" >/dev/null 2>&1 || true
  
  # Apply geometry one more time to ensure it sticks
  sleep 0.1
  xdotool windowsize "$wid" "$width" "$height" 2>/dev/null || true
  xdotool windowmove "$wid" 0 "$TOP" 2>/dev/null || true
}

wid="$(first_window || true)"

if [ -n "$wid" ]; then
  if is_visible "$wid" && ! is_minimized "$wid"; then
    # Window is visible and not minimized - minimize it
    xdotool windowminimize "$wid"
    exit 0
  fi
  if ! is_visible "$wid" && ! is_minimized "$wid"; then
    # Window is not visible and not minimized - it's in a bad state, kill it
    xdotool windowkill "$wid" 2>/dev/null || true
    rm -f "$SOCKET_FILE" "$HEIGHT_FILE"
    wid=""
  fi
  if is_minimized "$wid" && is_visible "$wid"; then
    # Window is minimized but still viewable - show it
    layout_window "$wid"
    xdotool windowactivate "$wid"
    exit 0
  fi
fi

if [ -n "$wid" ]; then
  layout_window "$wid"
  xdotool windowactivate "$wid"
  exit 0
fi

socket_path="/tmp/kitty-dropdown-$$"
printf 'unix:%s\n' "$socket_path" > "$SOCKET_FILE"
set -- $(xdotool getdisplaygeometry)
initial_width=$(($1 - 14))
initial_height="$DEFAULT_HEIGHT"
max_height="$(max_dropdown_height)"
[ "$initial_height" -gt "$max_height" ] && initial_height="$max_height"
"$KITTY" \
  --detach \
  --class "$APP_CLASS" \
  --name "$APP_CLASS" \
  --config "$CONFIG" \
  --listen-on "unix:$socket_path" \
  --override initial_window_width="$initial_width" \
  --override initial_window_height="$initial_height" \
  --directory "$HOME" \
  /usr/bin/zsh

# Wait for window to appear and layout properly (with timeout)
attempt=0
max_attempts=30
while [ $attempt -lt $max_attempts ]; do
  wid="$(first_window || true)"
  if [ -n "$wid" ] && is_visible "$wid"; then
    # Apply layout immediately when window becomes visible
    layout_window "$wid"
    sleep 0.05
    # Apply one more time to ensure it sticks after window manager accepts it
    layout_window "$wid"
    xdotool windowactivate "$wid"
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 0.05
done

printf "WARNING: Kitty window failed to appear after 1.5 seconds\n" >&2
exit 1
