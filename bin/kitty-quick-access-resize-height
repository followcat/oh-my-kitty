#!/bin/sh
set -eu

STEP="${1:-80}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kitty-quick-access"
HEIGHT_FILE="$STATE_DIR/height"
LOG_FILE="$STATE_DIR/resize-height.log"
APP_CLASS="kitty-quick-access-dropdown"
TOP="${KITTY_DROPDOWN_TOP:-53}"
MIN_HEIGHT="${KITTY_QUICK_ACCESS_MIN_HEIGHT:-360}"
MAX_HEIGHT_PERCENT="${KITTY_QUICK_ACCESS_MAX_HEIGHT_PERCENT:-100}"
DEFAULT_HEIGHT="${KITTY_QUICK_ACCESS_DEFAULT_HEIGHT:-820}"

mkdir -p "$STATE_DIR"

current_height() {
  height="$(cat "$HEIGHT_FILE" 2>/dev/null || true)"
  case "$height" in
    ''|*[!0-9]*) printf '%s\n' "$DEFAULT_HEIGHT" ;;
    *) printf '%s\n' "$height" ;;
  esac
}

wid="$(xdotool search --class "$APP_CLASS" 2>/dev/null | head -n 1 || true)"

set -- $(xdotool getdisplaygeometry)
screen_width=$(($1 - 14))
screen_height="$2"
default_max=$((screen_height * MAX_HEIGHT_PERCENT / 100))
absolute_max=$((screen_height - TOP))
[ "$default_max" -gt "$absolute_max" ] && default_max="$absolute_max"
MAX_HEIGHT="${KITTY_QUICK_ACCESS_MAX_HEIGHT:-$default_max}"

old_height="$(current_height)"
new_height=$((old_height + STEP))

[ "$new_height" -lt "$MIN_HEIGHT" ] && new_height="$MIN_HEIGHT"
[ "$new_height" -gt "$MAX_HEIGHT" ] && new_height="$MAX_HEIGHT"

printf '%s\n' "$new_height" > "$HEIGHT_FILE"

if [ -n "$wid" ]; then
  xdotool windowmove "$wid" 0 "$TOP"
  xdotool windowsize "$wid" "$screen_width" "$new_height"
fi

printf 'height_old=%s height_new=%s step=%s window=%s\n' "$old_height" "$new_height" "$STEP" "${wid:-none}" >> "$LOG_FILE" 2>/dev/null || true
